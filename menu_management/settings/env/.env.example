# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
POSTGRES_DB=menu_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
# Docker Compose: use the database service name.
# Running Django on the host: change this to 127.0.0.1 (published database port below).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Staff settings
STAFF_PASSWORD=your-staff-password-here
