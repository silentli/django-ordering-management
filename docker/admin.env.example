# Copy to .env.admin at the repository root and restrict permissions to 600.
# Set a unique strong password before running the initialization service.
# After migrations: docker compose -f docker/docker-compose.yml run --rm --build init-admin
# Delete .env.admin after successful initialization; retain the password in a password manager.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
# Keep the password single-quoted so special characters remain literal.
DJANGO_SUPERUSER_PASSWORD=''
