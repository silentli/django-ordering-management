# Copy to .env.deploy in the repository root. File values override the shell.
# KEY=value; quotes/comments allowed, no export or variable expansion.
# Reference: docs/devops/deployment.md and docs/devops/tls.md.

# Replace with public IPv4/domain (no scheme, port or path).
# Existing application ALLOWED_HOSTS must explicitly include this host.
PUBLIC_HOST=203.0.113.10

# http: HTTP application, no Certbot; letsencrypt: bootstrap, certificate, then HTTPS.
TLS_MODE=letsencrypt

# Let’s Encrypt API: staging (untrusted test certificates) or production (publicly trusted).
ACME_ENV=staging

# Required for new issuance; review https://letsencrypt.org/repository/ before enabling.
ACME_AGREE_TOS=false

# Absolute host paths with suitable permissions; keep these directories separate.
CERTBOT_WEBROOT=/var/www/certbot
LETSENCRYPT_DIR=/etc/letsencrypt

# Optional, reserved and unused; no expiry or renewal-failure notifications.
# ACME_EMAIL=admin@example.com
