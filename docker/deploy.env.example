# Copy to .env.deploy in the repository root, or use config check --file PATH.
# Validate: python3 scripts/manage.py config check
# Used only by config check in this stage; start/update do not apply it yet.
# Values in this file override built-in defaults. Shell variables do not override
# this file. Use KEY=value with optional quotes/comments; no export or expansion.

# Required: IPv4 address or DNS name, without scheme, port or path.
# Documentation example only; replace with the actual public entry point.
# Validation checks syntax, not ownership, DNS resolution or reachability.
PUBLIC_HOST=203.0.113.10

# http or letsencrypt. This is the intended mode, not automatic activation.
TLS_MODE=letsencrypt

# staging or production. Staging certificates are not browser-trusted.
ACME_ENV=staging

# Absolute Linux host paths; Nginx sees /var/www/certbot and /etc/letsencrypt.
# Keep these directories separate. No directories are created by config check.
CERTBOT_WEBROOT=/var/www/certbot
LETSENCRYPT_DIR=/etc/letsencrypt

# Optional, reserved for a future Certbot --email argument; not implemented.
# Does not configure SMTP or renewal-failure alerts. Let's Encrypt discontinued
# certificate expiration emails on June 4, 2025:
# https://letsencrypt.org/2025/06/26/expiration-notification-service-has-ended
# ACME_EMAIL=admin@example.com
